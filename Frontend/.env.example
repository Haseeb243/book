# ==========================================
# Frontend Configuration (Example Template)
# ==========================================

# Base URL for Backend API requests
# In local development: http://localhost:5000/api
# In production (with Nginx reverse proxy): /api
VITE_API_BASE_URL=http://localhost:5000/api

# Base URL for static assets/images
# In local development: http://localhost:5000
# In production: leave empty or use your domain origin
VITE_ASSET_BASE_URL=http://localhost:5000
