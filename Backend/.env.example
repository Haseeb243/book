# ==========================================
# Backend Server Configuration (Example Template)
# ==========================================

# Port on which the Express backend server listens
PORT=5000

# MongoDB connection string
# Local development default: mongodb://127.0.0.1:27017/hogwarts_bookstore
# Docker default: mongodb://mongodb:27017/hogwarts_bookstore
# Remote / MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/hogwarts_bookstore
MONGO_URI=mongodb://127.0.0.1:27017/hogwarts_bookstore

# Administrator email for granting admin dashboard access on login
ADMIN_EMAIL=admin@example.com

# Upload directory for book covers and uploaded files
UPLOAD_DIR=public
